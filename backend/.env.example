# Copy this file to .env  (cp .env.example .env)

PORT=5000
CLIENT_URL=http://localhost:5173

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgres://shop:shop123@localhost:5433/shopdb

# MongoDB (matches docker-compose.yml)
MONGO_URL=mongodb://localhost:27018/shopdb

# Change this to any long random string
JWT_SECRET=change-me-to-a-long-random-string
# Access token lifetime (short!) and refresh token lifetime in days
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7

# Stripe online payments (test mode). Get the keys at https://dashboard.stripe.com/test/apikeys
# Without STRIPE_SECRET_KEY the checkout only offers cash on delivery.
STRIPE_SECRET_KEY=
# Optional: printed by `stripe listen --forward-to localhost:5000/api/payments/webhook`
STRIPE_WEBHOOK_SECRET=
CURRENCY=eur
